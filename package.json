{
  "name": "handbook",
  "version": "1.0.0-debug",
  "description": "Create small, movable, and easily concealable windows for quick use.",
  "homepage": "https://github.com/ecromaneli/handbook",
  "author": {
    "name": "Emerson Capuchi Romaneli",
    "email": "emerson.romaneli@gmail.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run watch\" \"electron .\"",
    "start:dev": "npm run build:dev && electron .",
    "start": "npm run build && electron .",
    "build:dev": "npm run clean && webpack --mode development",
    "build": "npm run clean && webpack --mode production",
    "watch": "webpack --watch --mode development",
    "clean": "rimraf dist release",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux-deb": "npm run build && electron-builder --linux deb",
    "dist:linux-rpm": "npm run build && electron-builder --linux rpm",
    "dist:mac-arm64": "npm run build && electron-builder --mac zip --arm64",
    "dist:mac-x64": "npm run build && electron-builder --mac zip --x64",
    "dist:all": "npm run build && electron-builder --win --linux deb rpm --mac zip --x64 --arm64",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npx playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "extract-asar": "asar extract release/linux-unpacked/resources/app.asar dist/asar-unpacked"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/auto-launch": "^5.0.5",
    "@types/node": "^25.5.0",
    "clean-css": "^5.3.3",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "electron": "^40.8.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "html-minifier-terser": "^7.2.0",
    "rimraf": "^6.1.3",
    "terser-webpack-plugin": "^5.4.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.0"
  },
  "dependencies": {
    "@ecromaneli/search-engine": "^2.1.2",
    "auto-launch": "^5.0.6",
    "electron-context-menu": "^4.1.1",
    "electron-draggable": "^1.2.0",
    "electron-findbar": "^3.6.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "vue": "^3.5.30"
  }
}